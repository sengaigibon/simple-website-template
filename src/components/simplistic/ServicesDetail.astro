---
interface Props { cfg: any }
const { cfg } = Astro.props
const items = cfg.services?.items ?? []
---

<style>
  .service-row { display:grid; grid-template-columns:200px 1fr; gap:40px; padding:48px 0; border-bottom:1px solid var(--border-light); align-items:start; }
  .service-row:last-child { border-bottom:none; }
  .service-row__num { font-size:3.5rem; font-weight:800; color:var(--border); line-height:1; font-family:var(--font-display); padding-top:6px; }
  .service-features { list-style:none; margin-top:16px; display:flex; flex-direction:column; gap:7px; }
  .service-features li { font-size:.88rem; color:var(--text-muted); display:flex; gap:10px; align-items:flex-start; }
  .service-features li::before { content:'✓'; color:var(--accent-dark); font-weight:700; flex-shrink:0; }
  @media(max-width:768px){ .service-row { grid-template-columns:1fr; gap:8px; } .service-row__num { font-size:2rem; } }
</style>

<div>
  {items.map((item: any, i: number) => (
    <div class="service-row fade-up">
      <div class="service-row__num">{String(i + 1).padStart(2, '0')}</div>
      <div>
        <h3 style="font-size:1.2rem;margin-bottom:10px;">{item.title}</h3>
        <p>{item.body}</p>
        {item.features?.length > 0 && (
          <ul class="service-features">
            {item.features.map((f: string) => <li>{f}</li>)}
          </ul>
        )}
      </div>
    </div>
  ))}
</div>
