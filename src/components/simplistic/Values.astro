---
interface Props { cfg: any }
const { cfg } = Astro.props
const a = cfg.about
const values = a.values ?? []
---

<section class="section section--alt">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{a.values_headline}</span>
      <h2>{a.values_headline}</h2>
      <div class="divider"></div>
    </div>
    <div class="grid-3">
      {values.map((v: any) => (
        <div class="feature-card card fade-up" style="border:1px solid var(--border);border-radius:var(--radius-lg);">
          <div class="card__icon" style="margin:0 auto 14px;">{v.icon}</div>
          <h3>{v.title}</h3>
          <p>{v.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
