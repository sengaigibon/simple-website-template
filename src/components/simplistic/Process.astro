---
interface Props { cfg: any }
const { cfg } = Astro.props
const p = cfg.process
const steps = p.steps ?? []
---

<section class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{p.eyebrow}</span>
      <h2>{p.headline}</h2>
      <div class="divider"></div>
    </div>
    <div class="grid-3">
      {steps.map((step: any) => (
        <div class="feature-card fade-up">
          <div class="card__icon">{step.title}</div>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
