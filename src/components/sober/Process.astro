---
interface Props { cfg: any }
const { cfg } = Astro.props
const p = cfg.process
const steps = p?.steps ?? []
---

<div class="sidebar-section" style="margin-top:0;">
  <div class="sidebar-section__label">
    <span class="eyebrow">{p.eyebrow}</span>
    <h2>{p.headline}</h2>
  </div>
  <div class="sidebar-section__content">
    <div class="grid-2-cards">
      {steps.map((step: any, i: number) => (
        <div class:list={['card', 'fade-up', `fade-up-${i+1}`]}>
          <div class="card__icon" style="font-family:var(--font-display);font-weight:700;font-size:1.1rem;">
            {String(i + 1).padStart(2, '0')}
          </div>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </div>
      ))}
    </div>
  </div>
</div>
