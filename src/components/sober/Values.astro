---
interface Props { cfg: any; t: any }
const { cfg, t } = Astro.props
const a = cfg.about
const values = a?.values ?? []
---

<div class="about-block">
  <div class="about-block__label">
    <span class="eyebrow">{t.about.values_eyebrow}</span>
    <h2>{a.values_headline}</h2>
  </div>
  <div>
    <div class="grid-2-cards">
      {values.map((v: any, i: number) => (
        <div class:list={['card', 'fade-up', `fade-up-${i+1}`]}>
          <div class="card__icon">{v.icon || '●'}</div>
          <h3>{v.title}</h3>
          <p>{v.body}</p>
        </div>
      ))}
    </div>
  </div>
</div>
