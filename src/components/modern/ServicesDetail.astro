---
interface Props { cfg: any }
const { cfg } = Astro.props
const items = cfg.services?.items ?? []
---

<style>
  .service-block { display:grid; grid-template-columns:80px 1fr; gap:32px; padding:48px 0; border-bottom:1px solid var(--border); align-items:start; }
  .service-block:last-child { border-bottom:none; }
  .service-num { font-family:var(--font-display); font-size:3rem; font-weight:900; color:var(--border); line-height:1; }
  .service-block h3 { font-size:1.5rem; margin-bottom:12px; }
  .service-features { list-style:none; display:flex; flex-direction:column; gap:8px; margin-top:20px; }
  .service-features li { display:flex; align-items:center; gap:10px; font-size:.9rem; color:var(--text-muted); }
  .service-features li::before { content:'—'; color:var(--accent); font-weight:700; }
  @media(max-width:768px){ .service-block { grid-template-columns:1fr; gap:8px; } }
</style>

{items.map((item: any, i: number) => (
  <div class="service-block fade-up">
    <div class="service-num">{String(i + 1).padStart(2, '0')}</div>
    <div>
      <h3>{item.title}</h3>
      <p>{item.body}</p>
      {item.features?.length > 0 && (
        <ul class="service-features">
          {item.features.map((f: string) => <li>{f}</li>)}
        </ul>
      )}
    </div>
  </div>
))}
