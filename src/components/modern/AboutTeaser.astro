---
interface Props { cfg: any; t: any; lang: string }
const { cfg, t, lang } = Astro.props
const a = cfg.about
const testimonials = cfg.testimonials ?? []
---

<section class="section section--alt">
  <div class="container">
    <div class="grid-2">
      <div>
        <span class="eyebrow">{a.eyebrow}</span>
        <h2>{a.headline}</h2>
        <div class="divider"></div>
        <p>{a.body}</p>
        <a class="btn btn-primary" href={`/${lang}/about`} style="margin-top:24px;">{t.about.meet_team_btn}</a>
      </div>
      <div style="display:flex;flex-direction:column;gap:16px;">
        {testimonials.map((item: any) => (
          <div class="testimonial">
            <p class="testimonial__text">{item.text}</p>
            <div class="testimonial__author">
              <div class="testimonial__avatar">{item.emoji}</div>
              <div>
                <div class="testimonial__name">{item.author}</div>
                <div class="testimonial__role">{item.role}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
