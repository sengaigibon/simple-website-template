---
interface Props { cfg: any; t: any }
const { cfg } = Astro.props
const p = cfg.process
const steps = p.steps ?? []
---

<section class="section section--dark">
  <div class="container">
    <div class="section-head centered">
      <span class="eyebrow">{p.eyebrow}</span>
      <h2>{p.headline}</h2>
      <div class="divider centered"></div>
    </div>
    <div class="grid-4">
      {steps.map((step: any) => (
        <div class="card" style="background:rgba(255,255,255,.05);border-color:rgba(255,255,255,.1);">
          <div class="card__icon" style="background:rgba(255,255,255,.08);font-size:1.1rem;font-family:var(--font-display);font-weight:700;">{step.title}</div>
          <h3 style="color:var(--bg,#fff);">{step.title}</h3>
          <p>{step.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
